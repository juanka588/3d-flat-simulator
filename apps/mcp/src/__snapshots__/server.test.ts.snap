  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Add or replace (by zone.id, full replace) a floor zone: a part of a room floor with its own material, e.g. kitchen tiles in an open-plan room. The polygon must lie inside the room (1 cm tolerance) and not overlap the other zones of that room; define the material first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
        "roomId": {
          "description": "Id of the room (rooms[].id from list_rooms).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "zone": {
          "additionalProperties": false,
          "description": "The zone: id, optional name, polygon and material.",
          "properties": {
            "id": {
              "description": "Zone id, unique within its room.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "material": {
              "description": "Defined material id (list_materials).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "name": {
              "description": "Label.",
              "maxLength": 120,
              "type": "string",
            },
            "polygon": {
              "description": "Outline: [x, y] plan points in metres.",
              "items": {
                "items": {
                  "type": "number",
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
              },
              "maxItems": 500,
              "minItems": 3,
              "type": "array",
            },
          },
          "required": [
            "id",
            "polygon",
            "material",
          ],
          "type": "object",
        },
      },
      "required": [
        "roomId",
        "zone",
      ],
      "type": "object",
    },
    "name": "room_set_floor_zone",
  },
