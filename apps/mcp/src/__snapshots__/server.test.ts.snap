          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
