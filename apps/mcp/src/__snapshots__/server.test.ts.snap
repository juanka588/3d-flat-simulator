  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the undo and redo stacks (who changed what, newest last) and the named checkpoints. The stack is shared with the user: undo reverts the latest entry whoever made it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "How many of the newest entries to list (default 20).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "list_history",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Undo the newest entry of the shared history, whoever made it (the user's edits included); the result names the entry it reverted. To undo only what you have seen, pass expectId (the id of the last entry of list_history's past): if the newest entry is a different one, it fails with stale_scene and changes nothing. Without expectId it reverts whatever is on top at that moment.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expectId": {
          "description": "Optional. Id of the entry you mean to undo (the last item of past in list_history). Mismatch: stale_scene, nothing undone.",
          "maxLength": 64,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "undo",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Redo the most recently undone change (the user's too). Pass expectId (redoNext[0].id of list_history) to redo only that entry: if the next one differs, it fails with stale_scene and changes nothing.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expectId": {
          "description": "Optional. Id of the entry you mean to redo (redoNext[0] in list_history). Mismatch: stale_scene, nothing redone.",
          "maxLength": 64,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "redo",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Name the current state so you can return to it with restore_checkpoint. A name that exists is refused unless replace is true (which moves it to now). Take one before big edits.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Checkpoint name.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
        "replace": {
          "description": "true: move an existing checkpoint of that name to the current state (default false).",
          "type": "boolean",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "checkpoint",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Undo back to a named checkpoint, whoever made the changes since (the undone steps stay redoable). Fails with precondition_failed when the history was undone past the checkpoint or diverged from it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Checkpoint name (see list_history).",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "restore_checkpoint",
  },
]
`;
