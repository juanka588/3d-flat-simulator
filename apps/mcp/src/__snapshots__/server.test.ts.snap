        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
        "rotation": {
          "description": "Absolute rotation in degrees, counter-clockwise seen from above (the front faces plan +y at 0).",
          "type": "number",
        },
      },
      "required": [
        "id",
        "rotation",
      ],
      "type": "object",
    },
    "name": "item_rotate",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Remove a placed item by id (items[].id from describe_room). A locked item (existing furniture) can only be removed by the user. Undo puts it back at the same position in the list. Find the item id with describe_room; get_bill_of_materials shows the cost.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
