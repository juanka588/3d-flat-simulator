  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Move a placed item (items[].id from describe_room) to a new plan position, optionally with a new rotation, height, room or placement relation. Omitted fields stay as they are; roomId and relation accept null to clear. Refused with placement_invalid when the new spot is outside the room, over a wall or another item, or in a door swing, and with precondition_failed for a locked item (existing furniture such as a built-in wardrobe; only the user may move it). Call validate_layout afterwards to check windows and walkways. Undo moves it back. To find a valid spot first, call get_placement_options.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "elevation": {
          "description": "New height of the item bottom above the floor, in metres. Optional.",
          "minimum": 0,
          "type": "number",
        },
        "id": {
          "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "position": {
          "description": "New plan position [x, y] of the item origin, in metres.",
          "items": {
            "type": "number",
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "relation": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "align": {
                      "default": "center",
                      "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                      "enum": [
                        "start",
                        "center",
                        "end",
                      ],
                      "type": "string",
                    },
                    "gap": {
                      "default": 0,
                      "description": "Gap in m to what it touches (0).",
                      "maximum": 2,
                      "minimum": 0,
                      "type": "number",
                    },
                    "kind": {
                      "const": "against_wall",
                      "description": "Relation discriminator, always "against_wall".",
                      "type": "string",
                    },
                    "offset": {
                      "default": 0,
                      "description": "Metres from the aligned end of the wall to the nearest edge of the item (ignored for "center").",
                      "minimum": 0,
                      "type": "number",
                    },
                    "roomId": {
                      "description": "Room on the wall side to use when a wall borders two rooms (rooms[].id).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "wallId": {
                      "description": "Wall to stand against (walls[].wallId from describe_room).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "wallId",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "corner": {
                      "description": "Index of the room polygon vertex (rooms[].polygon order); 0 is the first vertex.",
                      "minimum": 0,
                      "type": "integer",
                    },
                    "gap": {
                      "default": 0,
                      "description": "Gap in m to what it touches (0).",
                      "maximum": 2,
                      "minimum": 0,
                      "type": "number",
                    },
                    "kind": {
                      "const": "in_corner",
                      "description": "Relation discriminator, always "in_corner".",
                      "type": "string",
                    },
                    "roomId": {
                      "description": "Room whose corner to use (rooms[].id).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "roomId",
                    "corner",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "axis": {
                      "default": "both",
                      "description": "Centre on both plan axes, or only on x / y (the other coordinate is then kept).",
                      "enum": [
                        "both",
                        "x",
                        "y",
                      ],
                      "type": "string",
                    },
                    "kind": {
                      "const": "centered_in",
                      "description": "Relation discriminator, always "centered_in".",
                      "type": "string",
                    },
                    "roomId": {
                      "description": "Room to centre in (rooms[].id).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "roomId",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "facing",
                      "description": "Relation discriminator, always "facing".",
                      "type": "string",
                    },
                    "targetId": {
                      "description": "Entity to face: an item id, an opening id, a wall id or a room id.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "targetId",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "align": {
                      "default": "center",
                      "description": "Alignment along that side: start, middle or end.",
                      "enum": [
                        "start",
                        "center",
                        "end",
                      ],
                      "type": "string",
                    },
                    "gap": {
                      "default": 0.02,
                      "description": "Gap in m to what it touches (0).",
                      "maximum": 2,
                      "minimum": 0,
                      "type": "number",
                    },
                    "itemId": {
                      "description": "The existing item to stand next to (items[].id).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "kind": {
                      "const": "next_to",
                      "description": "Relation discriminator, always "next_to".",
                      "type": "string",
                    },
                    "side": {
                      "description": "Side of that item, as seen from its front.",
                      "enum": [
                        "left",
                        "right",
                        "front",
                        "back",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "itemId",
                    "side",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "gap": {
                      "default": 0,
                      "description": "Gap in m to what it touches (0).",
                      "maximum": 2,
                      "minimum": 0,
                      "type": "number",
                    },
                    "kind": {
                      "const": "under_window",
                      "description": "Relation discriminator, always "under_window".",
                      "type": "string",
                    },
                    "openingId": {
                      "description": "Window (openings[].id) to stand under.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "openingId",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "elevation": {
                      "default": 0,
                      "description": "Height of the item bottom above the floor, in metres.",
                      "minimum": 0,
                      "type": "number",
                    },
                    "kind": {
                      "const": "at",
                      "description": "Relation discriminator, always "at".",
                      "type": "string",
                    },
                    "position": {
                      "description": "Plan position [x, y] of the item origin (footprint centre).",
                      "items": {
                        "type": "number",
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array",
                    },
                    "rotation": {
                      "default": 0,
                      "description": "Degrees counter-clockwise seen from above.",
                      "type": "number",
                    },
                  },
                  "required": [
                    "kind",
                    "position",
                  ],
                  "type": "object",
                },
              ],
            },
            {
              "type": "null",
            },
          ],
          "description": "The placement intent that produced this position; null clears it. Optional.",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
        "roomId": {
          "description": "Room the item now belongs to (rooms[].id); null clears it. Optional.",
          "maxLength": 64,
          "minLength": 1,
          "type": [
            "string",
            "null",
          ],
        },
        "rotation": {
          "description": "New rotation in degrees, counter-clockwise seen from above. Optional.",
          "type": "number",
        },
      },
      "required": [
        "id",
        "position",
      ],
      "type": "object",
    },
    "name": "item_move",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Turn a placed item to an absolute rotation in degrees, counter-clockwise seen from above (the front faces plan +y at 0, +x at 90, -y at 180, -x at 270). The footprint turns about the item origin and is checked like item_move (placement_invalid when it no longer fits). Locked items cannot be rotated by an LLM. Undo restores the previous rotation.",
