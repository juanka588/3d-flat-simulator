                    },
                    "lumens": {
                      "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                      "minimum": 0,
                      "type": "number",
                    },
                    "name": {
                      "description": "Optional label, at most 120 characters.",
                      "maxLength": 120,
                      "type": "string",
                    },
                    "on": {
                      "default": true,
                      "description": "Whether the light is switched on. Defaults to true.",
                      "type": "boolean",
                    },
                    "position": {
                      "description": "Plan position [x, y] in metres; plan y grows down the page.",
                      "items": {
                        "type": "number",
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array",
                    },
                    "roomId": {
                      "description": "Room the light belongs to (from list_rooms). Optional.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "type": {
                      "const": "spot",
                      "description": "A spot light shines straight down in a cone. Discriminator: "spot".",
                      "type": "string",
                    },
                  },
                  "required": [
                    "position",
                    "elevation",
                    "lumens",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "depth": {
                      "description": "Panel depth in metres along plan y before rotation.",
                      "exclusiveMinimum": 0,
                      "type": "number",
                    },
                    "elevation": {
                      "description": "Height of the light source above the floor, in metres.",
                      "minimum": 0,
                      "type": "number",
                    },
                    "id": {
                      "description": "Optional light id; derived as "light-N" when omitted.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "kelvin": {
                      "default": 2700,
                      "description": "Colour temperature in kelvin, 1000-12000 (2700 warm, 6500 daylight). Defaults to 2700.",
                      "maximum": 12000,
                      "minimum": 1000,
                      "type": "number",
                    },
                    "lumens": {
                      "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                      "minimum": 0,
                      "type": "number",
                    },
                    "name": {
                      "description": "Optional label, at most 120 characters.",
                      "maxLength": 120,
                      "type": "string",
                    },
                    "on": {
                      "default": true,
                      "description": "Whether the light is switched on. Defaults to true.",
                      "type": "boolean",
                    },
                    "position": {
                      "description": "Plan position [x, y] in metres; plan y grows down the page.",
                      "items": {
                        "type": "number",
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array",
                    },
                    "roomId": {
                      "description": "Room the light belongs to (from list_rooms). Optional.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "rotation": {
                      "default": 0,
                      "description": "Panel rotation in degrees, counter-clockwise seen from above. Defaults to 0.",
                      "type": "number",
                    },
                    "type": {
                      "const": "area",
                      "description": "A rectangular panel facing down. Discriminator: "area".",
                      "type": "string",
                    },
                    "width": {
                      "description": "Panel width in metres along plan x before rotation.",
                      "exclusiveMinimum": 0,
                      "type": "number",
                    },
                  },
                  "required": [
                    "position",
                    "elevation",
                    "lumens",
                    "type",
                    "width",
                    "depth",
                  ],
                  "type": "object",
                },
              ],
              "description": "The light to add: point, spot or area, discriminated by its "type".",
            },
            "type": {
              "const": "light.add",
              "description": "Command discriminator, always "light.add".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "light",
          ],
          "type": "object",
        },
        "light_remove": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Id of the light to remove.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "light.remove",
              "description": "Command discriminator, always "light.remove".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "id",
          ],
          "type": "object",
        },
        "light_update": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Id of the light (lights[].id from get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "patch": {
              "additionalProperties": false,
              "description": "Fields to change; omitted fields stay as they are, null clears name and roomId. A light cannot take fields of another light type.",
              "properties": {
                "angle": {
                  "description": "Spot lights only: cone angle in degrees (1-179).",
                  "maximum": 179,
                  "minimum": 1,
                  "type": "number",
                },
                "depth": {
                  "description": "Area lights only: depth in metres.",
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
                "elevation": {
                  "description": "Height of the light source above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "kelvin": {
                  "description": "Colour temperature in kelvin, 1000-12000.",
                  "maximum": 12000,
                  "minimum": 1000,
                  "type": "number",
                },
                "lumens": {
                  "description": "Luminous flux in lumens.",
                  "minimum": 0,
                  "type": "number",
                },
                "name": {
                  "description": "Label (at most 120 characters); null clears it.",
                  "maxLength": 120,
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "on": {
                  "description": "Whether the light is switched on.",
                  "type": "boolean",
                },
                "position": {
                  "description": "Plan position [x, y] in metres; plan y grows down the page.",
                  "items": {
                    "type": "number",
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                },
                "roomId": {
                  "description": "Room the light belongs to (from list_rooms); null clears it.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "rotation": {
                  "description": "Area lights only: rotation in degrees, counter-clockwise seen from above.",
                  "type": "number",
                },
                "width": {
                  "description": "Area lights only: width in metres.",
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
              },
              "type": "object",
            },
            "type": {
              "const": "light.update",
              "description": "Command discriminator, always "light.update".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "id",
            "patch",
          ],
          "type": "object",
        },
        "material_define": {
          "additionalProperties": false,
          "properties": {
            "material": {
              "additionalProperties": false,
              "description": "The complete material. An existing id is fully replaced (omitted optional fields are cleared); kind cannot change.",
              "properties": {
                "color": {
                  "description": "Base colour as #rrggbb. For textures it is the fallback and tint colour.",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "type": "string",
                },
                "id": {
                  "description": "Material id (1-64 characters), unique across all entities. Reference it from finishes and defaults.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kind": {
                  "description": ""paint" is a flat colour; "texture" adds a PBR texture set (needs textureUrl). Cannot change once defined.",
                  "enum": [
                    "paint",
                    "texture",
                  ],
                  "type": "string",
                },
                "name": {
                  "description": "Human-readable name, at most 120 characters.",
                  "maxLength": 120,
                  "type": "string",
                },
                "roughness": {
                  "default": 0.9,
                  "description": "Surface roughness from 0 (mirror) to 1 (matte). Defaults to 0.9.",
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number",
                },
                "textureScale": {
                  "description": "Size in metres of one texture tile. Optional.",
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
                "textureUrl": {
                  "description": "Texture set as "lib:<slug>"; read materials://list for the available slugs. Required when kind is "texture".",
                  "type": "string",
                },
              },
              "required": [
                "id",
                "name",
                "kind",
                "color",
              ],
              "type": "object",
            },
            "type": {
              "const": "material.define",
              "description": "Command discriminator, always "material.define".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "material",
          ],
          "type": "object",
        },
        "material_remove": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Id of the material to delete. Fails with precondition_failed while any wall, room or default uses it.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "material.remove",
              "description": "Command discriminator, always "material.remove".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "id",
          ],
          "type": "object",
        },
        "room_set_ceiling": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "description": "Id of a defined material (materials[].id in get_scene_summary), or null to clear back to the default. To use a library texture first call material.define with textureUrl "lib:<slug>" (slugs: materials://list).",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "description": "Id of the room (from list_rooms or get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setCeiling",
              "description": "Command discriminator, always "room.setCeiling".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "room_set_floor": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "description": "Id of a defined material (materials[].id in get_scene_summary), or null to clear back to the default. To use a library texture first call material.define with textureUrl "lib:<slug>" (slugs: materials://list).",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "description": "Id of the room (from list_rooms or get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setFloor",
              "description": "Command discriminator, always "room.setFloor".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "room_set_wall_finish": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "description": "Id of a defined material (materials[].id in get_scene_summary), or null to clear back to the default. To use a library texture first call material.define with textureUrl "lib:<slug>" (slugs: materials://list).",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "description": "Id of the room (from list_rooms or get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setWallFinish",
              "description": "Command discriminator, always "room.setWallFinish".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "scene_set_defaults": {
          "additionalProperties": false,
          "properties": {
            "ceiling": {
              "description": "Default ceiling material. Omit to leave unchanged, null to clear.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "floor": {
              "description": "Default floor material. Omit to leave unchanged, null to clear.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "type": {
              "const": "scene.setDefaults",
              "description": "Command discriminator, always "scene.setDefaults".",
              "type": "string",
            },
            "wall": {
              "description": "Default wall material for faces without a finish. Omit to leave unchanged, null to clear.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
          },
          "required": [
            "type",
          ],
          "type": "object",
        },
        "site_set": {
          "additionalProperties": false,
          "properties": {
            "site": {
              "additionalProperties": false,
              "description": "Fields to change; omitted fields stay as they are.",
              "properties": {
                "address": {
                  "description": "Postal address (at most 300 characters); null clears it.",
                  "maxLength": 300,
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "floorElevation": {
                  "description": "Height of the flat floor above street level, in metres.",
                  "type": "number",
                },
                "latitude": {
                  "description": "Latitude in degrees, -90 to 90 (north positive).",
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number",
                },
                "longitude": {
                  "description": "Longitude in degrees, -180 to 180 (east positive).",
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number",
                },
                "northAngle": {
                  "description": "Clockwise angle in degrees from plan "up" (-y) to true north.",
                  "type": "number",
                },
                "timezone": {
                  "description": "IANA time zone such as "Europe/Paris".",
                  "type": "string",
                },
              },
              "type": "object",
            },
            "type": {
              "const": "site.set",
              "description": "Command discriminator, always "site.set".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "site",
          ],
          "type": "object",
        },
        "wall_set_finish": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "description": "Id of a defined material (materials[].id in get_scene_summary), or null to clear back to the default. To use a library texture first call material.define with textureUrl "lib:<slug>" (slugs: materials://list).",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "description": "The room whose stretch of this wall side to paint (from list_rooms or describe_room). Strongly recommended: a wall side can be shared by several rooms (e.g. the alcove and the sejour) and without roomId the whole side is painted for all of them. Fails with precondition_failed if the room does not border that side. A room-scoped finish beats the whole-side finish and room.setWallFinish.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "side": {
              "description": "Which face of the wall. "left" is the left of someone walking from the wall start to its end on the plan (plan y grows down; see wallLeftNormal), "right" the other face, "both" both faces. With roomId, "both" means every face of this wall that the room adjoins.",
              "enum": [
                "left",
                "right",
                "both",
              ],
              "type": "string",
            },
            "type": {
              "const": "wall.setFinish",
              "description": "Command discriminator, always "wall.setFinish".",
              "type": "string",
            },
            "wallId": {
              "description": "Id of the wall (walls[].id from get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "wallId",
            "side",
            "materialId",
          ],
          "type": "object",
        },
        "wall_set_structural": {
          "additionalProperties": false,
          "properties": {
            "structural": {
              "description": "true marks the wall structural (cannot be removed); false marks it removable; null clears the explicit mark so it is derived (exterior or at least 15 cm thick means structural). Only a user may set false on a wall that is structural by default.",
              "type": [
                "boolean",
                "null",
              ],
            },
            "type": {
              "const": "wall.setStructural",
              "description": "Command discriminator, always "wall.setStructural".",
              "type": "string",
            },
            "wallId": {
              "description": "Id of the wall (walls[].id from get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "wallId",
            "structural",
          ],
          "type": "object",
        },
      },
      "additionalProperties": false,
      "properties": {
        "commands": {
          "description": "Commands applied in order and atomically: all succeed or none apply. At most 500; batches cannot nest.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/material_define",
              },
              {
                "$ref": "#/$defs/material_remove",
              },
              {
                "$ref": "#/$defs/wall_set_finish",
              },
              {
                "$ref": "#/$defs/wall_set_structural",
              },
              {
                "$ref": "#/$defs/room_set_wall_finish",
              },
              {
                "$ref": "#/$defs/room_set_floor",
              },
              {
                "$ref": "#/$defs/room_set_ceiling",
              },
              {
                "$ref": "#/$defs/scene_set_defaults",
              },
              {
                "$ref": "#/$defs/site_set",
              },
              {
                "$ref": "#/$defs/light_add",
              },
              {
                "$ref": "#/$defs/light_update",
              },
              {
                "$ref": "#/$defs/light_remove",
              },
            ],
          },
          "maxItems": 500,
          "type": "array",
        },
        "label": {
          "description": "Short description of the whole change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "label",
        "commands",
      ],
      "type": "object",
    },
    "name": "batch",
  },
