  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Change fields of a light (not fields of another light type). Grid: rows, cols, lumensEach, kelvin, angle, on, or fitToRoom: true. A lamp item's light (describe_room lights[].itemId) follows its item: only on, lumens, kelvin, name change; move the item instead.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the light (lights[].id from describe_room, or lights[].id from get_scene_summary with detail "full").",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "patch": {
          "additionalProperties": false,
          "description": "Fields to change; omitted ones stay, null clears name and roomId.",
          "properties": {
            "angle": {
              "description": "Spot and grid only: cone angle in degrees (1-179).",
              "maximum": 179,
              "minimum": 1,
              "type": "number",
            },
            "cols": {
              "description": "Grid only: columns (1-20).",
              "maximum": 20,
              "minimum": 1,
              "type": "integer",
            },
            "depth": {
              "description": "Area and grid only: depth in metres.",
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "elevation": {
              "description": "Height above the floor, in metres.",
              "minimum": 0,
              "type": "number",
            },
            "fitToRoom": {
              "description": "Grid only: true: cover the room's largest rectangle (needs roomId).",
              "type": "boolean",
            },
            "kelvin": {
              "description": "Kelvin, 1000-12000.",
              "maximum": 12000,
              "minimum": 1000,
              "type": "number",
            },
            "lumens": {
              "description": "Luminous flux in lumens (a grid uses lumensEach).",
              "minimum": 0,
              "type": "number",
            },
            "lumensEach": {
              "description": "Grid only: lumens of each fixture.",
              "minimum": 0,
              "type": "number",
            },
            "lumensSource": {
              "description": "Internal (undo).",
              "enum": [
                "product",
                "estimated",
                "user",
                null,
              ],
              "type": [
                "string",
                "null",
              ],
            },
            "name": {
              "description": "Label; null clears.",
              "maxLength": 120,
              "type": [
                "string",
                "null",
              ],
            },
            "on": {
              "description": "Switched on.",
              "type": "boolean",
            },
            "position": {
              "description": "Plan [x, y] in metres (y down); a grid: its centre.",
              "items": {
                "type": "number",
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
            },
            "roomId": {
              "description": "Room id (list_rooms); null clears.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "rotation": {
              "description": "Area and grid only: rotation in degrees, counter-clockwise seen from above.",
              "type": "number",
            },
            "rows": {
              "description": "Grid only: rows (1-20; rows x cols at most 100).",
              "maximum": 20,
              "minimum": 1,
              "type": "integer",
            },
            "width": {
              "description": "Area and grid only: width in metres.",
              "exclusiveMinimum": 0,
              "type": "number",
            },
          },
          "type": "object",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
      },
      "required": [
        "id",
        "patch",
      ],
      "type": "object",
    },
    "name": "light_update",
  },
