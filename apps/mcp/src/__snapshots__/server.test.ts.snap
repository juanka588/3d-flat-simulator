    },
    "name": "list_materials",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Set the session's date, time or lighting preset used by later renders (does not change the flat).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Local date YYYY-MM-DD at the flat.",
          "type": "string",
        },
        "preset": {
          "enum": [
            "day",
            "evening",
            "night",
          ],
          "type": "string",
        },
        "time": {
          "description": "Local time HH:mm.",
          "type": "string",
        },
