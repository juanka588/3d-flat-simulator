                "h",
              ],
              "type": [
                "object",
                "null",
              ],
            },
            "id": {
              "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "product": {
              "additionalProperties": false,
              "description": "Snapshot of the chosen variant (resolved by the server from its record; never invented). Optional.",
              "properties": {
                "category": {
                  "description": "Furniture category of the product.",
                  "enum": [
                    "bed",
                    "wardrobe",
                    "bedside",
                    "drawers",
                    "shelf",
                    "sideboard",
                    "tv_unit",
                    "table",
                    "desk",
                    "chair",
                    "armchair",
                    "sofa",
                    "rug",
                    "lamp",
                    "mirror",
                    "wall_cabinet",
                    "kitchen",
                    "appliance",
                    "decor",
                    "other",
                  ],
                  "type": "string",
                },
                "colour": {
                  "description": "Chosen colour when the product has several. Optional.",
                  "maxLength": 40,
                  "minLength": 1,
                  "type": "string",
                },
                "currency": {
                  "description": "ISO 4217 currency code, e.g. "EUR".",
                  "pattern": "^[A-Z]{3}$",
                  "type": "string",
                },
                "dims": {
                  "additionalProperties": false,
                  "description": "Assembled outer dimensions in metres, as returned by the server.",
                  "properties": {
                    "d": {
                      "description": "Depth in metres (item-local z; the front is at +d/2).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "h": {
                      "description": "Height in metres (item-local y, measured up from the item bottom).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "w": {
                      "description": "Width in metres (item-local x).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                  },
                  "required": [
                    "w",
                    "d",
                    "h",
                  ],
                  "type": "object",
                },
                "name": {
                  "description": "Product name as listed by the provider.",
                  "maxLength": 200,
                  "type": "string",
                },
                "price": {
                  "description": "Shelf price including VAT (TTC) in \`currency\`, as returned by the server.",
                  "maximum": 1000000,
                  "minimum": 0,
                  "type": "number",
                },
                "provider": {
                  "description": "Provider id, e.g. "ikea-fr".",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "type": "string",
                },
                "sku": {
                  "description": "Provider article number.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "snapshotAt": {
                  "description": "When the facts were read from the provider (ISO 8601 date-time).",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string",
                },
                "url": {
                  "description": "Public product page (the buy link).",
                  "format": "uri",
                  "maxLength": 2048,
                  "type": "string",
                },
              },
              "required": [
                "provider",
                "sku",
                "name",
                "url",
                "price",
                "currency",
                "dims",
                "category",
                "snapshotAt",
              ],
              "type": "object",
            },
            "type": {
              "const": "item.setVariant",
              "description": "Command discriminator, always "item.setVariant".",
              "type": "string",
            },
            "variant": {
              "description": "Variant SKU of the product (variants[].sku); null clears it.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
          },
          "required": [
            "type",
            "id",
            "variant",
          ],
          "type": "object",
        },
