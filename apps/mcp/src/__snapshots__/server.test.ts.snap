    "description": "Apply several commands atomically as one undo step: if any fails nothing is applied and the error path says which (commands/N/...). Prefer it for multi-step edits. At most 500 commands; batches cannot nest.",
    "inputSchema": {
      "$defs": {
        "light_add": {
          "additionalProperties": false,
          "properties": {
            "light": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "elevation": {
                      "description": "Height of the light source above the floor, in metres.",
                      "minimum": 0,
                      "type": "number",
                    },
                    "id": {
                      "description": "Optional light id; derived as "light-N" when omitted.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "kelvin": {
                      "default": 2700,
                      "description": "Colour temperature in kelvin, 1000-12000 (2700 warm, 6500 daylight). Defaults to 2700.",
                      "maximum": 12000,
                      "minimum": 1000,
                      "type": "number",
                    },
                    "lumens": {
                      "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                      "minimum": 0,
                      "type": "number",
                    },
                    "name": {
                      "description": "Optional label, at most 120 characters.",
                      "maxLength": 120,
                      "type": "string",
                    },
                    "on": {
                      "default": true,
                      "description": "Whether the light is switched on. Defaults to true.",
                      "type": "boolean",
                    },
                    "position": {
                      "description": "Plan position [x, y] in metres; plan y grows down the page.",
                      "items": {
                        "type": "number",
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array",
                    },
                    "roomId": {
                      "description": "Room the light belongs to (from list_rooms). Optional.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "type": {
                      "const": "point",
                      "description": "A point light radiates in all directions. Discriminator: "point".",
                      "type": "string",
                    },
                  },
                  "required": [
                    "position",
                    "elevation",
                    "lumens",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
