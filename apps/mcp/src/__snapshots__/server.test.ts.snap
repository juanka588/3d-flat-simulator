  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Turn a placed item to an absolute rotation in degrees, counter-clockwise seen from above (the front faces plan +y at 0, +x at 90, -y at 180, -x at 270). The footprint turns about the item origin and is checked like item_move (placement_invalid when it no longer fits). Locked items cannot be rotated by an LLM. Undo restores the previous rotation.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
        "rotation": {
          "description": "Absolute rotation in degrees, counter-clockwise seen from above (the front faces plan +y at 0).",
          "type": "number",
        },
      },
      "required": [
        "id",
        "rotation",
      ],
      "type": "object",
    },
    "name": "item_rotate",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Switch a placed product to another variant (variants[].sku of the product record): a colour or size, usually another article with its own price and dimensions. Pass the variant SKU and the product snapshot and dims the server resolved for it; variant null clears the choice, dims null returns to the product dimensions. The new dimensions are checked like item_move (placement_invalid when the item no longer fits). Undo restores the previous variant, price and dimensions. get_product lists the variants (variants[].sku) of a product.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dims": {
          "additionalProperties": false,
          "description": "Dimensions of the chosen variant when they differ; null clears them back to the product dimensions. Optional.",
          "properties": {
            "d": {
              "description": "Depth in metres (item-local z; the front is at +d/2).",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number",
            },
            "h": {
              "description": "Height in metres (item-local y, measured up from the item bottom).",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number",
            },
            "w": {
              "description": "Width in metres (item-local x).",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number",
            },
          },
          "required": [
            "w",
            "d",
            "h",
          ],
          "type": [
            "object",
            "null",
          ],
        },
        "id": {
          "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "product": {
          "additionalProperties": false,
          "description": "Snapshot of the chosen variant (resolved by the server from its record; never invented). Optional.",
          "properties": {
            "category": {
              "description": "Furniture category of the product.",
              "enum": [
                "bed",
                "wardrobe",
                "bedside",
                "drawers",
                "shelf",
                "sideboard",
                "tv_unit",
                "table",
                "desk",
                "chair",
                "armchair",
                "sofa",
                "rug",
                "lamp",
                "mirror",
                "wall_cabinet",
                "kitchen",
                "appliance",
                "decor",
                "other",
              ],
              "type": "string",
            },
            "colour": {
              "description": "Chosen colour when the product has several. Optional.",
              "maxLength": 40,
              "minLength": 1,
              "type": "string",
            },
            "currency": {
              "description": "ISO 4217 currency code, e.g. "EUR".",
              "pattern": "^[A-Z]{3}$",
              "type": "string",
            },
            "dims": {
              "additionalProperties": false,
              "description": "Assembled outer dimensions in metres, as returned by the server.",
              "properties": {
                "d": {
                  "description": "Depth in metres (item-local z; the front is at +d/2).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
                "h": {
                  "description": "Height in metres (item-local y, measured up from the item bottom).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
                "w": {
                  "description": "Width in metres (item-local x).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
              },
              "required": [
                "w",
                "d",
                "h",
              ],
              "type": "object",
            },
            "name": {
              "description": "Product name as listed by the provider.",
              "maxLength": 200,
              "type": "string",
            },
            "price": {
              "description": "Shelf price including VAT (TTC) in \`currency\`, as returned by the server.",
              "maximum": 1000000,
              "minimum": 0,
              "type": "number",
            },
            "provider": {
              "description": "Provider id, e.g. "ikea-fr".",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
              "type": "string",
            },
            "sku": {
              "description": "Provider article number.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "snapshotAt": {
              "description": "When the facts were read from the provider (ISO 8601 date-time).",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
            "url": {
              "description": "Public product page (the buy link).",
              "format": "uri",
              "maxLength": 2048,
              "type": "string",
            },
          },
          "required": [
            "provider",
            "sku",
            "name",
            "url",
            "price",
            "currency",
            "dims",
            "category",
            "snapshotAt",
          ],
          "type": "object",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
        "variant": {
          "description": "Variant SKU of the product (variants[].sku); null clears it.",
          "maxLength": 64,
          "minLength": 1,
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "id",
        "variant",
      ],
      "type": "object",
    },
    "name": "item_set_variant",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Remove a placed item by id (items[].id from describe_room). A locked item (existing furniture) can only be removed by the user. Undo puts it back at the same position in the list. To find which item to remove, read items[] with describe_room; get_bill_of_materials shows the cost.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "item_remove",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Apply several commands atomically as one undo step: if any fails nothing is applied and the error path says which (commands/N/...). Prefer it for multi-step edits. Batches cannot nest. Each item is a tool's arguments plus its "type" (the command type of that tool, e.g. "room.setFloor" for room_set_floor). At most 50 commands per batch.",
    "inputSchema": {
      "$defs": {
        "item_move": {
          "additionalProperties": false,
          "properties": {
            "elevation": {
              "description": "New height of the item bottom above the floor, in metres. Optional.",
              "minimum": 0,
              "type": "number",
            },
            "id": {
              "description": "Id of the item (items[].id from describe_room or get_scene_summary).",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "position": {
              "description": "New plan position [x, y] of the item origin, in metres.",
              "items": {
                "type": "number",
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
            },
            "relation": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "align": {
                          "default": "center",
                          "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                          "enum": [
                            "start",
                            "center",
                            "end",
                          ],
                          "type": "string",
                        },
                        "gap": {
                          "default": 0,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "against_wall",
                          "description": "Relation discriminator, always "against_wall".",
                          "type": "string",
                        },
                        "offset": {
                          "default": 0,
                          "description": "Metres from the aligned end of the wall to the nearest edge of the item (ignored for "center").",
                          "minimum": 0,
                          "type": "number",
                        },
                        "roomId": {
                          "description": "Room on the wall side to use when a wall borders two rooms (rooms[].id).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        "wallId": {
                          "description": "Wall to stand against (walls[].wallId from describe_room).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "wallId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "corner": {
                          "description": "Index of the room polygon vertex (rooms[].polygon order); 0 is the first vertex.",
                          "minimum": 0,
                          "type": "integer",
                        },
                        "gap": {
                          "default": 0,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "in_corner",
                          "description": "Relation discriminator, always "in_corner".",
                          "type": "string",
                        },
                        "roomId": {
                          "description": "Room whose corner to use (rooms[].id).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "roomId",
                        "corner",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "axis": {
                          "default": "both",
                          "description": "Centre on both plan axes, or only on x / y (the other coordinate is then kept).",
                          "enum": [
                            "both",
                            "x",
                            "y",
                          ],
                          "type": "string",
                        },
                        "kind": {
                          "const": "centered_in",
                          "description": "Relation discriminator, always "centered_in".",
                          "type": "string",
                        },
                        "roomId": {
                          "description": "Room to centre in (rooms[].id).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "roomId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "facing",
                          "description": "Relation discriminator, always "facing".",
                          "type": "string",
                        },
                        "targetId": {
                          "description": "Entity to face: an item id, an opening id, a wall id or a room id.",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "targetId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "align": {
                          "default": "center",
                          "description": "Alignment along that side: start, middle or end.",
                          "enum": [
                            "start",
                            "center",
                            "end",
                          ],
                          "type": "string",
                        },
                        "gap": {
                          "default": 0.02,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "itemId": {
                          "description": "The existing item to stand next to (items[].id).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        "kind": {
                          "const": "next_to",
                          "description": "Relation discriminator, always "next_to".",
                          "type": "string",
                        },
                        "side": {
                          "description": "Side of that item, as seen from its front.",
                          "enum": [
                            "left",
                            "right",
                            "front",
                            "back",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "itemId",
                        "side",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "gap": {
                          "default": 0,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "under_window",
                          "description": "Relation discriminator, always "under_window".",
                          "type": "string",
                        },
                        "openingId": {
                          "description": "Window (openings[].id) to stand under.",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "openingId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "elevation": {
                          "default": 0,
                          "description": "Height of the item bottom above the floor, in metres.",
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "at",
                          "description": "Relation discriminator, always "at".",
                          "type": "string",
                        },
                        "position": {
                          "description": "Plan position [x, y] of the item origin (footprint centre).",
                          "items": {
                            "type": "number",
                          },
                          "maxItems": 2,
                          "minItems": 2,
                          "type": "array",
                        },
                        "rotation": {
                          "default": 0,
                          "description": "Degrees counter-clockwise seen from above.",
                          "type": "number",
                        },
                      },
                      "required": [
                        "kind",
                        "position",
                      ],
                      "type": "object",
                    },
                  ],
                },
                {
                  "type": "null",
                },
              ],
              "description": "The placement intent that produced this position; null clears it. Optional.",
            },
            "roomId": {
              "description": "Room the item now belongs to (rooms[].id); null clears it. Optional.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "rotation": {
              "description": "New rotation in degrees, counter-clockwise seen from above. Optional.",
              "type": "number",
            },
            "type": {
              "const": "item.move",
              "description": "Command discriminator, always "item.move".",
              "type": "string",
            },
          },
          "required": [
            "type",
            "id",
            "position",
          ],
          "type": "object",
        },
        "item_place": {
          "additionalProperties": false,
          "properties": {
            "item": {
              "additionalProperties": false,
              "description": "The complete item: position, rotation, productRef + product snapshot, dims, mesh source and relation, as resolved by the placement solver.",
              "properties": {
                "assetId": {
                  "description": "Shape id: "product:<provider>", a library asset id or "param:<generator>" (see meshAssetId); legacy "builtin:*" ids still load.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "clearance": {
                  "additionalProperties": false,
                  "description": "Free space wanted around the item, in metres per side. Optional.",
                  "properties": {
                    "back": {
                      "description": "Free space wanted behind, in metres. Optional.",
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number",
                    },
                    "front": {
                      "description": "Free space wanted in front, in metres. Optional.",
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number",
                    },
                    "left": {
                      "description": "Free space wanted on the left seen from the front, in metres. Optional.",
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number",
                    },
                    "right": {
                      "description": "Free space wanted on the right seen from the front, in metres. Optional.",
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
                "dims": {
                  "additionalProperties": false,
                  "description": "Exact outer dimensions in metres; defaults to the product dimensions. Optional.",
                  "properties": {
                    "d": {
                      "description": "Depth in metres (item-local z; the front is at +d/2).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "h": {
                      "description": "Height in metres (item-local y, measured up from the item bottom).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "w": {
                      "description": "Width in metres (item-local x).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                  },
                  "required": [
                    "w",
                    "d",
                    "h",
                  ],
                  "type": "object",
                },
                "elevation": {
                  "default": 0,
                  "description": "Height of the item bottom above the floor, in metres; must be 0 for floor items. Defaults to 0.",
                  "type": "number",
                },
                "id": {
                  "description": "Optional item id (1-64 characters, unique across all entities); derived as "item-N" when omitted.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "locked": {
                  "description": "Existing furniture the designer must plan around (only the user may set it). Optional.",
                  "type": "boolean",
                },
                "mesh": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "provider",
                          "description": "Mesh source discriminator, always "provider": the provider's real model of productRef, streamed by the local server.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "assetId": {
                          "description": "Id of the library asset (search_assets).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        "kind": {
                          "const": "lookalike",
                          "description": "Mesh source discriminator, always "lookalike": a library model scaled to the exact dims.",
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "assetId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "generator": {
                          "description": "Generator id (search_assets).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        "kind": {
                          "const": "parametric",
                          "description": "Mesh source discriminator, always "parametric": a generator at the exact dims.",
                          "type": "string",
                        },
                        "params": {
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "maxLength": 64,
                                "type": "string",
                              },
                              {
                                "type": "boolean",
                              },
                            ],
                          },
                          "default": {},
                          "description": "Scalar generator parameters; omitted keys use the generator defaults.",
                          "propertyNames": {
                            "maxLength": 32,
                            "minLength": 1,
                            "type": "string",
                          },
                          "type": "object",
                        },
                      },
                      "required": [
                        "kind",
                        "generator",
                      ],
                      "type": "object",
                    },
                  ],
                  "description": "How the 3D shape is obtained (provider model, library lookalike or parametric generator). Optional.",
                },
                "mount": {
                  "description": "Where the item is fixed: "floor", "wall" (hung) or "ceiling". Optional; derived from the asset.",
                  "enum": [
                    "floor",
                    "wall",
                    "ceiling",
                  ],
                  "type": "string",
                },
                "position": {
                  "description": "Plan position [x, y] of the item origin (footprint centre), in metres; plan y grows down.",
                  "items": {
                    "type": "number",
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                },
                "product": {
                  "additionalProperties": false,
                  "description": "Product facts (name, TTC price, link, dims, snapshot date) as returned by the server; never invented.",
                  "properties": {
                    "category": {
                      "description": "Furniture category of the product.",
                      "enum": [
                        "bed",
                        "wardrobe",
                        "bedside",
                        "drawers",
                        "shelf",
                        "sideboard",
                        "tv_unit",
                        "table",
                        "desk",
                        "chair",
                        "armchair",
                        "sofa",
                        "rug",
                        "lamp",
                        "mirror",
                        "wall_cabinet",
                        "kitchen",
                        "appliance",
                        "decor",
                        "other",
                      ],
                      "type": "string",
                    },
                    "colour": {
                      "description": "Chosen colour when the product has several. Optional.",
                      "maxLength": 40,
                      "minLength": 1,
                      "type": "string",
                    },
                    "currency": {
                      "description": "ISO 4217 currency code, e.g. "EUR".",
                      "pattern": "^[A-Z]{3}$",
                      "type": "string",
                    },
                    "dims": {
                      "additionalProperties": false,
                      "description": "Assembled outer dimensions in metres, as returned by the server.",
                      "properties": {
                        "d": {
                          "description": "Depth in metres (item-local z; the front is at +d/2).",
                          "exclusiveMinimum": 0,
                          "maximum": 20,
                          "type": "number",
                        },
                        "h": {
                          "description": "Height in metres (item-local y, measured up from the item bottom).",
                          "exclusiveMinimum": 0,
                          "maximum": 20,
                          "type": "number",
                        },
                        "w": {
                          "description": "Width in metres (item-local x).",
                          "exclusiveMinimum": 0,
                          "maximum": 20,
                          "type": "number",
                        },
                      },
                      "required": [
                        "w",
                        "d",
                        "h",
                      ],
                      "type": "object",
                    },
                    "name": {
                      "description": "Product name as listed by the provider.",
                      "maxLength": 200,
                      "type": "string",
                    },
                    "price": {
                      "description": "Shelf price including VAT (TTC) in \`currency\`, as returned by the server.",
                      "maximum": 1000000,
                      "minimum": 0,
                      "type": "number",
                    },
                    "provider": {
                      "description": "Provider id, e.g. "ikea-fr".",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                      "type": "string",
                    },
                    "sku": {
                      "description": "Provider article number.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "snapshotAt": {
                      "description": "When the facts were read from the provider (ISO 8601 date-time).",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "type": "string",
                    },
                    "url": {
                      "description": "Public product page (the buy link).",
                      "format": "uri",
                      "maxLength": 2048,
                      "type": "string",
                    },
                  },
                  "required": [
                    "provider",
                    "sku",
                    "name",
                    "url",
                    "price",
                    "currency",
                    "dims",
                    "category",
                    "snapshotAt",
                  ],
                  "type": "object",
                },
                "productRef": {
                  "additionalProperties": false,
                  "description": "The real product this item stands for. Required for items placed by an LLM or the planner (unless product is given).",
                  "properties": {
                    "provider": {
                      "description": "Provider id, e.g. "ikea-fr".",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                      "type": "string",
                    },
                    "sku": {
                      "description": "Provider article number.",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "provider",
                    "sku",
                  ],
                  "type": "object",
                },
                "relation": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "align": {
                          "default": "center",
                          "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                          "enum": [
                            "start",
                            "center",
                            "end",
                          ],
                          "type": "string",
                        },
                        "gap": {
                          "default": 0,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "against_wall",
                          "description": "Relation discriminator, always "against_wall".",
                          "type": "string",
                        },
                        "offset": {
                          "default": 0,
                          "description": "Metres from the aligned end of the wall to the nearest edge of the item (ignored for "center").",
                          "minimum": 0,
                          "type": "number",
                        },
                        "roomId": {
                          "description": "Room on the wall side to use when a wall borders two rooms (rooms[].id).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                        "wallId": {
                          "description": "Wall to stand against (walls[].wallId from describe_room).",
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "kind",
                        "wallId",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "corner": {
                          "description": "Index of the room polygon vertex (rooms[].polygon order); 0 is the first vertex.",
                          "minimum": 0,
                          "type": "integer",
                        },
                        "gap": {
                          "default": 0,
                          "description": "Free gap in metres between the item and what it touches (default 0).",
                          "maximum": 2,
                          "minimum": 0,
                          "type": "number",
                        },
                        "kind": {
                          "const": "in_corner",
                          "description": "Relation discriminator, always "in_corner".",
                          "type": "string",
                        },
                        "roomId": {
