        "item_set_variant": {
          "additionalProperties": false,
          "properties": {
            "dims": {
              "additionalProperties": false,
              "description": "Dimensions of the chosen variant when they differ; null clears them back to the product dimensions. Optional.",
              "properties": {
                "d": {
                  "description": "Depth in metres (item-local z; the front is at +d/2).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
                "h": {
                  "description": "Height in metres (item-local y, measured up from the item bottom).",
                  "exclusiveMinimum": 0,
