        "site",
      ],
      "type": "object",
    },
    "name": "site_set",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Add a light (point, spot or area). The id is derived (light-N) when omitted.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "light": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "elevation": {
                  "description": "Height of the light source above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "id": {
                  "description": "Optional light id; derived as "light-N" when omitted.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kelvin": {
                  "default": 2700,
                  "description": "Colour temperature in kelvin, 1000-12000 (2700 warm, 6500 daylight). Defaults to 2700.",
                  "maximum": 12000,
                  "minimum": 1000,
                  "type": "number",
                },
                "lumens": {
                  "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                  "minimum": 0,
                  "type": "number",
                },
                "name": {
                  "description": "Optional label, at most 120 characters.",
                  "maxLength": 120,
                  "type": "string",
                },
                "on": {
                  "default": true,
                  "description": "Whether the light is switched on. Defaults to true.",
                  "type": "boolean",
                },
                "position": {
                  "description": "Plan position [x, y] in metres; plan y grows down the page.",
                  "items": {
                    "type": "number",
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                },
                "roomId": {
                  "description": "Room the light belongs to (rooms[].id from list_rooms). Optional.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "type": {
                  "const": "point",
                  "description": "A point light radiates in all directions. Discriminator: "point".",
                  "type": "string",
                },
              },
              "required": [
                "position",
                "elevation",
                "lumens",
                "type",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "angle": {
                  "default": 60,
                  "description": "Spot cone angle in degrees (1-179). Defaults to 60.",
                  "maximum": 179,
                  "minimum": 1,
                  "type": "number",
                },
                "elevation": {
                  "description": "Height of the light source above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "id": {
                  "description": "Optional light id; derived as "light-N" when omitted.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kelvin": {
                  "default": 2700,
                  "description": "Colour temperature in kelvin, 1000-12000 (2700 warm, 6500 daylight). Defaults to 2700.",
                  "maximum": 12000,
                  "minimum": 1000,
                  "type": "number",
                },
                "lumens": {
                  "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                  "minimum": 0,
                  "type": "number",
                },
                "name": {
                  "description": "Optional label, at most 120 characters.",
                  "maxLength": 120,
                  "type": "string",
                },
                "on": {
                  "default": true,
                  "description": "Whether the light is switched on. Defaults to true.",
                  "type": "boolean",
                },
                "position": {
                  "description": "Plan position [x, y] in metres; plan y grows down the page.",
                  "items": {
                    "type": "number",
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                },
                "roomId": {
                  "description": "Room the light belongs to (rooms[].id from list_rooms). Optional.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "type": {
                  "const": "spot",
                  "description": "A spot light shines straight down in a cone. Discriminator: "spot".",
                  "type": "string",
                },
              },
              "required": [
                "position",
                "elevation",
                "lumens",
                "type",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "depth": {
                  "description": "Panel depth in metres along plan y before rotation.",
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
                "elevation": {
                  "description": "Height of the light source above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "id": {
                  "description": "Optional light id; derived as "light-N" when omitted.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kelvin": {
                  "default": 2700,
                  "description": "Colour temperature in kelvin, 1000-12000 (2700 warm, 6500 daylight). Defaults to 2700.",
                  "maximum": 12000,
                  "minimum": 1000,
                  "type": "number",
                },
                "lumens": {
                  "description": "Luminous flux in lumens (a 60 W-equivalent bulb is about 800).",
                  "minimum": 0,
                  "type": "number",
                },
                "name": {
                  "description": "Optional label, at most 120 characters.",
                  "maxLength": 120,
                  "type": "string",
                },
                "on": {
                  "default": true,
                  "description": "Whether the light is switched on. Defaults to true.",
                  "type": "boolean",
                },
                "position": {
                  "description": "Plan position [x, y] in metres; plan y grows down the page.",
                  "items": {
                    "type": "number",
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                },
                "roomId": {
                  "description": "Room the light belongs to (rooms[].id from list_rooms). Optional.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "rotation": {
                  "default": 0,
                  "description": "Panel rotation in degrees, counter-clockwise seen from above. Defaults to 0.",
                  "type": "number",
                },
                "type": {
                  "const": "area",
                  "description": "A rectangular panel facing down. Discriminator: "area".",
                  "type": "string",
                },
                "width": {
                  "description": "Panel width in metres along plan x before rotation.",
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
              },
              "required": [
                "position",
                "elevation",
                "lumens",
                "type",
                "width",
                "depth",
              ],
              "type": "object",
            },
          ],
          "description": "The light to add: point, spot or area, discriminated by its "type".",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
      },
      "required": [
        "light",
      ],
      "type": "object",
    },
    "name": "light_add",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Change fields of an existing light. Omitted fields stay unchanged; name and roomId accept null to clear. A light cannot take fields of another light type.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the light (lights[].id from describe_room, or lights[].id from get_scene_summary with detail "full").",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "patch": {
          "additionalProperties": false,
          "description": "Fields to change; omitted fields stay as they are, null clears name and roomId. A light cannot take fields of another light type.",
          "properties": {
            "angle": {
              "description": "Spot lights only: cone angle in degrees (1-179).",
              "maximum": 179,
              "minimum": 1,
              "type": "number",
            },
            "depth": {
              "description": "Area lights only: depth in metres.",
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "elevation": {
              "description": "Height of the light source above the floor, in metres.",
              "minimum": 0,
              "type": "number",
            },
            "kelvin": {
              "description": "Colour temperature in kelvin, 1000-12000.",
              "maximum": 12000,
              "minimum": 1000,
              "type": "number",
            },
            "lumens": {
              "description": "Luminous flux in lumens.",
              "minimum": 0,
              "type": "number",
            },
            "name": {
              "description": "Label (at most 120 characters); null clears it.",
              "maxLength": 120,
              "type": [
                "string",
                "null",
              ],
            },
            "on": {
              "description": "Whether the light is switched on.",
              "type": "boolean",
            },
            "position": {
              "description": "Plan position [x, y] in metres; plan y grows down the page.",
              "items": {
                "type": "number",
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
            },
            "roomId": {
              "description": "Room the light belongs to (rooms[].id from list_rooms); null clears it.",
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "rotation": {
              "description": "Area lights only: rotation in degrees, counter-clockwise seen from above.",
              "type": "number",
            },
            "width": {
              "description": "Area lights only: width in metres.",
              "exclusiveMinimum": 0,
              "type": "number",
            },
          },
          "type": "object",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
      },
      "required": [
        "id",
        "patch",
      ],
      "type": "object",
    },
    "name": "light_update",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Remove a light by id. Undo restores it at the same position in the list.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Id of the light to remove (lights[].id from describe_room, or lights[].id from get_scene_summary with detail "full").",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: do NOT change the flat; return what the change would do (diff, warnings, would-be changed ids). Use it to show the user before applying.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments (view, roomId, ...): also return an image of the result (after the change, or of the previewed state). true = the overview of the first changed room, else the whole flat from above. Without the render service the result carries render_unavailable.",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "light_remove",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Put a real, purchasable product into a room. Only products returned by search_products may be placed; an item without productRef or product is refused with precondition_failed ("search_products first"). Normally use place_item, which finds a valid position and rotation and fills in the product facts (price, dims, link) from the server's record; never type those yourself. The item is refused with placement_invalid when it would stand outside its room, overlap a wall or another item, or block a door swing (the message and hint say which and what to try). Windows, glazing, heavy wall mounts and walkways are checked by place_item and validate_layout. Item frame: the front faces plan +y at rotation 0; rotation is degrees counter-clockwise seen from above; a floor item has elevation 0. The id is derived (item-N) when omitted. At most 60 items per room. Undo removes the item. Prefer place_item: it checks the product against search_products and fills in price, dims and link itself. To see valid spots first, call get_placement_options; get_product lists variants and weight.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "item": {
          "additionalProperties": false,
          "description": "The complete item: position, rotation, productRef + product snapshot, dims, mesh source and relation, as resolved by the placement solver.",
          "properties": {
            "assetId": {
              "description": "Shape id: "product:<provider>", a library asset id or "param:<generator>" (see meshAssetId); legacy "builtin:*" ids still load.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "clearance": {
              "additionalProperties": false,
              "description": "Free space wanted around the item, in metres per side. Optional.",
              "properties": {
                "back": {
                  "description": "Free space wanted behind, in metres. Optional.",
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number",
                },
                "front": {
                  "description": "Free space wanted in front, in metres. Optional.",
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number",
                },
                "left": {
                  "description": "Free space wanted on the left seen from the front, in metres. Optional.",
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number",
                },
                "right": {
                  "description": "Free space wanted on the right seen from the front, in metres. Optional.",
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number",
                },
              },
              "type": "object",
            },
            "dims": {
              "additionalProperties": false,
              "description": "Exact outer dimensions in metres; defaults to the product dimensions. Optional.",
              "properties": {
                "d": {
                  "description": "Depth in metres (item-local z; the front is at +d/2).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
                "h": {
                  "description": "Height in metres (item-local y, measured up from the item bottom).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
                "w": {
                  "description": "Width in metres (item-local x).",
                  "exclusiveMinimum": 0,
                  "maximum": 20,
                  "type": "number",
                },
              },
              "required": [
                "w",
                "d",
                "h",
              ],
              "type": "object",
            },
            "elevation": {
              "default": 0,
              "description": "Height of the item bottom above the floor, in metres; must be 0 for floor items. Defaults to 0.",
              "type": "number",
            },
            "id": {
              "description": "Optional item id (1-64 characters, unique across all entities); derived as "item-N" when omitted.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "locked": {
              "description": "Existing furniture the designer must plan around (only the user may set it). Optional.",
              "type": "boolean",
            },
            "mesh": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "provider",
                      "description": "Mesh source discriminator, always "provider": the provider's real model of productRef, streamed by the local server.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "assetId": {
                      "description": "Id of the library asset (search_assets).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "kind": {
                      "const": "lookalike",
                      "description": "Mesh source discriminator, always "lookalike": a library model scaled to the exact dims.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "kind",
                    "assetId",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "generator": {
                      "description": "Generator id (search_assets).",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "kind": {
                      "const": "parametric",
                      "description": "Mesh source discriminator, always "parametric": a generator at the exact dims.",
                      "type": "string",
                    },
                    "params": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "number",
                          },
                          {
                            "maxLength": 64,
                            "type": "string",
                          },
                          {
                            "type": "boolean",
                          },
                        ],
                      },
                      "default": {},
                      "description": "Scalar generator parameters; omitted keys use the generator defaults.",
                      "propertyNames": {
                        "maxLength": 32,
                        "minLength": 1,
                        "type": "string",
                      },
                      "type": "object",
                    },
                  },
                  "required": [
                    "kind",
                    "generator",
                  ],
                  "type": "object",
                },
              ],
              "description": "How the 3D shape is obtained (provider model, library lookalike or parametric generator). Optional.",
            },
            "mount": {
              "description": "Where the item is fixed: "floor", "wall" (hung) or "ceiling". Optional; derived from the asset.",
              "enum": [
                "floor",
                "wall",
                "ceiling",
              ],
              "type": "string",
            },
            "position": {
              "description": "Plan position [x, y] of the item origin (footprint centre), in metres; plan y grows down.",
              "items": {
                "type": "number",
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
            },
            "product": {
              "additionalProperties": false,
              "description": "Product facts (name, TTC price, link, dims, snapshot date) as returned by the server; never invented.",
              "properties": {
                "category": {
                  "description": "Furniture category of the product.",
                  "enum": [
                    "bed",
                    "wardrobe",
                    "bedside",
                    "drawers",
                    "shelf",
                    "sideboard",
                    "tv_unit",
                    "table",
                    "desk",
                    "chair",
                    "armchair",
                    "sofa",
                    "rug",
                    "lamp",
                    "mirror",
                    "wall_cabinet",
                    "kitchen",
                    "appliance",
                    "decor",
                    "other",
                  ],
                  "type": "string",
                },
                "colour": {
                  "description": "Chosen colour when the product has several. Optional.",
                  "maxLength": 40,
                  "minLength": 1,
                  "type": "string",
                },
                "currency": {
                  "description": "ISO 4217 currency code, e.g. "EUR".",
                  "pattern": "^[A-Z]{3}$",
                  "type": "string",
                },
                "dims": {
                  "additionalProperties": false,
                  "description": "Assembled outer dimensions in metres, as returned by the server.",
                  "properties": {
                    "d": {
                      "description": "Depth in metres (item-local z; the front is at +d/2).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "h": {
                      "description": "Height in metres (item-local y, measured up from the item bottom).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                    "w": {
                      "description": "Width in metres (item-local x).",
                      "exclusiveMinimum": 0,
                      "maximum": 20,
                      "type": "number",
                    },
                  },
                  "required": [
                    "w",
                    "d",
                    "h",
                  ],
                  "type": "object",
                },
                "name": {
                  "description": "Product name as listed by the provider.",
                  "maxLength": 200,
                  "type": "string",
                },
                "price": {
                  "description": "Shelf price including VAT (TTC) in \`currency\`, as returned by the server.",
                  "maximum": 1000000,
                  "minimum": 0,
                  "type": "number",
                },
                "provider": {
                  "description": "Provider id, e.g. "ikea-fr".",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "type": "string",
                },
                "sku": {
                  "description": "Provider article number.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "snapshotAt": {
                  "description": "When the facts were read from the provider (ISO 8601 date-time).",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string",
                },
                "url": {
                  "description": "Public product page (the buy link).",
                  "format": "uri",
                  "maxLength": 2048,
                  "type": "string",
                },
              },
              "required": [
                "provider",
                "sku",
                "name",
                "url",
                "price",
                "currency",
                "dims",
                "category",
                "snapshotAt",
              ],
              "type": "object",
            },
            "productRef": {
              "additionalProperties": false,
              "description": "The real product this item stands for. Required for items placed by an LLM or the planner (unless product is given).",
              "properties": {
                "provider": {
                  "description": "Provider id, e.g. "ikea-fr".",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "type": "string",
                },
                "sku": {
                  "description": "Provider article number.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "provider",
                "sku",
              ],
              "type": "object",
            },
            "relation": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "align": {
                      "default": "center",
                      "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                      "enum": [
                        "start",
