      "readOnlyHint": false,
    },
    "description": "Paint one or both faces of a wall. Pass roomId (strongly recommended) to paint only that room's stretch of the face: the alcove and the sejour can share a wall and get different colours. Without roomId the whole face is painted for every room on it. Precedence on a stretch of face, most specific first: the room-scoped finish (roomId), the whole-face finish, the room's paint-all-walls (room_set_wall_finish), the scene default. Left and right follow the walking direction from wall start to end on the plan (plan y grows down). materialId null clears the finish.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "materialId": {
          "description": "Id of a defined material (materials[].id in get_scene_summary), or null to clear back to the default. To use a library texture first call material.define with textureUrl "lib:<slug>" (slugs: materials://list).",
          "maxLength": 64,
          "minLength": 1,
          "type": [
            "string",
            "null",
          ],
        },
        "roomId": {
          "description": "The room whose stretch of this wall side to paint (from list_rooms or describe_room). Strongly recommended: a wall side can be shared by several rooms (e.g. the alcove and the sejour) and without roomId the whole side is painted for all of them. Fails with precondition_failed if the room does not border that side. A room-scoped finish beats the whole-side finish and room.setWallFinish.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "side": {
