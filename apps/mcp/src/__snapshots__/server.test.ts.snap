        },
        "room_remove_floor_zone": {
          "additionalProperties": false,
          "properties": {
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.removeFloorZone",
              "type": "string",
            },
            "zoneId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "zoneId",
          ],
          "type": "object",
        },
        "room_set_ceiling": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setCeiling",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "room_set_floor": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setFloor",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "room_set_floor_zone": {
          "additionalProperties": false,
          "properties": {
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setFloorZone",
              "type": "string",
            },
            "zone": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "material": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "name": {
                  "maxLength": 120,
                  "type": "string",
                },
                "polygon": {
                  "items": {
                    "items": {
                      "type": "number",
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array",
                  },
                  "maxItems": 500,
                  "minItems": 3,
                  "type": "array",
                },
              },
              "required": [
                "id",
                "polygon",
                "material",
              ],
              "type": "object",
            },
          },
          "required": [
            "type",
            "roomId",
            "zone",
          ],
          "type": "object",
        },
        "room_set_floor_zone_material": {
          "additionalProperties": false,
          "properties": {
            "material": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setFloorZoneMaterial",
              "type": "string",
            },
            "zoneId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "zoneId",
            "material",
          ],
          "type": "object",
        },
        "room_set_wall_finish": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": {
              "const": "room.setWallFinish",
              "type": "string",
            },
          },
          "required": [
            "type",
            "roomId",
            "materialId",
          ],
          "type": "object",
        },
        "scene_set_defaults": {
          "additionalProperties": false,
          "properties": {
            "ceiling": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "floor": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "type": {
              "const": "scene.setDefaults",
              "type": "string",
            },
            "wall": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
          },
          "required": [
            "type",
          ],
          "type": "object",
        },
        "site_set": {
          "additionalProperties": false,
          "properties": {
            "site": {
              "additionalProperties": false,
              "properties": {
                "address": {
                  "maxLength": 300,
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "floorElevation": {
                  "type": "number",
                },
                "latitude": {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number",
                },
                "longitude": {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number",
                },
                "northAngle": {
                  "type": "number",
                },
                "timezone": {
                  "type": "string",
                },
              },
              "type": "object",
            },
            "type": {
              "const": "site.set",
              "type": "string",
            },
          },
          "required": [
            "type",
            "site",
          ],
          "type": "object",
        },
        "wall_set_finish": {
          "additionalProperties": false,
          "properties": {
            "materialId": {
              "maxLength": 64,
              "minLength": 1,
              "type": [
                "string",
                "null",
              ],
            },
            "roomId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "side": {
              "enum": [
                "left",
                "right",
                "both",
              ],
              "type": "string",
            },
            "type": {
              "const": "wall.setFinish",
              "type": "string",
            },
            "wallId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "wallId",
            "side",
            "materialId",
          ],
          "type": "object",
        },
        "wall_set_structural": {
          "additionalProperties": false,
          "properties": {
            "structural": {
              "type": [
                "boolean",
                "null",
              ],
            },
            "type": {
              "const": "wall.setStructural",
              "type": "string",
            },
            "wallId": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "type",
            "wallId",
            "structural",
          ],
          "type": "object",
        },
      },
      "additionalProperties": false,
      "properties": {
        "commands": {
          "description": "Commands applied in order and atomically: all succeed or none apply. At most 50 per batch (split larger edits); batches cannot nest.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/material_define",
              },
              {
                "$ref": "#/$defs/material_remove",
              },
              {
                "$ref": "#/$defs/wall_set_finish",
              },
              {
                "$ref": "#/$defs/wall_set_structural",
              },
              {
                "$ref": "#/$defs/room_set_wall_finish",
              },
              {
                "$ref": "#/$defs/room_set_floor",
              },
              {
                "$ref": "#/$defs/room_set_ceiling",
              },
              {
                "$ref": "#/$defs/scene_set_defaults",
              },
              {
                "$ref": "#/$defs/site_set",
              },
              {
                "$ref": "#/$defs/light_add",
              },
              {
                "$ref": "#/$defs/light_update",
              },
              {
                "$ref": "#/$defs/light_remove",
              },
              {
                "$ref": "#/$defs/item_move",
              },
              {
                "$ref": "#/$defs/item_rotate",
              },
              {
                "$ref": "#/$defs/item_remove",
              },
              {
                "$ref": "#/$defs/room_set_floor_zone",
              },
              {
                "$ref": "#/$defs/room_remove_floor_zone",
              },
              {
                "$ref": "#/$defs/room_set_floor_zone_material",
              },
            ],
          },
          "maxItems": 50,
          "type": "array",
        },
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of the whole change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
      },
      "required": [
        "label",
        "commands",
      ],
      "type": "object",
    },
    "name": "batch",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Put a real product into a room. The productId must come from search_products or get_product in this session (else unknown_product); name, price, dimensions and link come from the server's product record, not from you. Give a relation (against_wall, in_corner, centered_in, facing, next_to, under_window: the server finds a valid position and rotation) or an explicit position + rotation. Several products: pass items[] (up to 12, one undo step, placed in order). An invalid spot gives placement_invalid with the violations and alternative candidates. The shape defaults to the real 3D model, else a lookalike, else a parametric shape at the exact dims. To switch a placed item to another colour or size, pass only itemId + variantSku (variants[].sku from get_product); price and dims are rebuilt. A lamp comes with a light (placed[].light, switch or dim it with light_update). Check the result with validate_layout.",
    "inputSchema": {
      "$defs": {
        "mesh": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "provider",
                  "type": "string",
                },
              },
              "required": [
                "kind",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kind": {
                  "const": "lookalike",
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "assetId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "generator": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kind": {
                  "const": "parametric",
                  "type": "string",
                },
                "params": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number",
                      },
                      {
                        "maxLength": 64,
                        "type": "string",
                      },
                      {
                        "type": "boolean",
                      },
                    ],
                  },
                  "default": {},
                  "propertyNames": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "object",
                },
              },
              "required": [
                "kind",
                "generator",
              ],
              "type": "object",
            },
          ],
        },
        "placement": {
          "additionalProperties": false,
          "properties": {
            "acknowledgeHeavyPartition": {
              "description": "Accept hanging a heavy (over 15 kg) wall product on a non-structural wall.",
              "type": "boolean",
            },
            "elevation": {
              "description": "Wall or ceiling products only: height of the bottom above the floor, metres.",
              "maximum": 10,
              "minimum": 0,
              "type": "number",
            },
            "mesh": {
              "$ref": "#/$defs/mesh",
              "description": "Optional shape. Default: the real 3D model when the provider has one, else a lookalike from the CC0 library, else a parametric shape at the exact dims. A parametric shape must match the product dims within 2%.",
            },
            "position": {
              "description": "Explicit plan position [x, y] of the item centre, metres. Use this OR relation.",
              "items": {
                "type": "number",
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
            },
            "productId": {
              "description": "productId returned by search_products or get_product in this session, "<provider>:<sku>".",
              "type": "string",
            },
            "relation": {
              "$ref": "#/$defs/relation",
              "description": "Where, in designer terms (against_wall, in_corner, centered_in, facing, next_to, under_window). The server finds the exact position and rotation. Use this OR position. In items[], "$0" as the itemId of next_to (targetId of facing) means the item entry 0 of the same call places.",
            },
            "roomId": {
              "description": "Room to place in (list_rooms).",
              "type": "string",
            },
            "rotation": {
              "description": "With position: degrees counter-clockwise seen from above (front faces plan +y at 0). With relation: an extra turn, usually omitted.",
              "type": "number",
            },
            "variantSku": {
              "description": "A variants[].sku from get_product (another colour or size).",
              "type": "string",
            },
          },
          "required": [
            "productId",
            "roomId",
          ],
          "type": "object",
        },
        "relation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "align": {
                  "default": "center",
                  "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                  "enum": [
                    "start",
                    "center",
                    "end",
                  ],
                  "type": "string",
                },
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "against_wall",
                  "description": "Relation discriminator, always "against_wall".",
                  "type": "string",
                },
                "offset": {
                  "default": 0,
                  "description": "Metres from the aligned end of the wall to the nearest edge of the item (ignored for "center").",
                  "minimum": 0,
                  "type": "number",
                },
                "roomId": {
                  "description": "Room on the wall side to use when a wall borders two rooms (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "wallId": {
                  "description": "Wall to stand against (walls[].wallId from describe_room).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "wallId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "corner": {
                  "description": "Index of the room polygon vertex (rooms[].polygon order); 0 is the first vertex.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "in_corner",
                  "description": "Relation discriminator, always "in_corner".",
                  "type": "string",
                },
                "roomId": {
                  "description": "Room whose corner to use (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "roomId",
                "corner",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "default": "both",
                  "description": "Centre on both plan axes, or only on x / y (the other coordinate is then kept).",
                  "enum": [
                    "both",
                    "x",
                    "y",
                  ],
                  "type": "string",
                },
                "kind": {
                  "const": "centered_in",
                  "description": "Relation discriminator, always "centered_in".",
                  "type": "string",
                },
                "roomId": {
                  "description": "Room to centre in (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "roomId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "facing",
                  "description": "Relation discriminator, always "facing".",
                  "type": "string",
                },
                "targetId": {
                  "description": "Entity to face: an item id, an opening id, a wall id or a room id.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "targetId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "align": {
                  "default": "center",
                  "description": "Alignment along that side: start, middle or end.",
                  "enum": [
                    "start",
                    "center",
                    "end",
                  ],
                  "type": "string",
                },
                "gap": {
                  "default": 0.02,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "itemId": {
                  "description": "The existing item to stand next to (items[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kind": {
                  "const": "next_to",
                  "description": "Relation discriminator, always "next_to".",
                  "type": "string",
                },
                "side": {
                  "description": "Side of that item, as seen from its front.",
                  "enum": [
                    "left",
                    "right",
                    "front",
                    "back",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "itemId",
                "side",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "under_window",
                  "description": "Relation discriminator, always "under_window".",
                  "type": "string",
                },
                "openingId": {
                  "description": "Window (openings[].id) to stand under.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "openingId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "elevation": {
                  "default": 0,
                  "description": "Height of the item bottom above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "at",
                  "description": "Relation discriminator, always "at".",
                  "type": "string",
                },
                "position": {
                  "description": "Plan position [x, y] of the item origin (footprint centre).",
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                  ],
                  "type": "array",
                },
                "rotation": {
                  "default": 0,
                  "description": "Degrees counter-clockwise seen from above.",
                  "type": "number",
                },
              },
              "required": [
                "kind",
                "position",
              ],
              "type": "object",
            },
          ],
        },
      },
      "additionalProperties": false,
      "properties": {
        "acknowledgeHeavyPartition": {
          "$ref": "#/$defs/placement/properties/acknowledgeHeavyPartition",
        },
        "elevation": {
          "$ref": "#/$defs/placement/properties/elevation",
        },
        "ifRev": {
          "description": "Apply only if the flat is at this rev (or preview baseRev), else stale_scene.",
          "minimum": 0,
          "type": "integer",
        },
        "itemId": {
          "description": "Variant mode: id of a placed item (describe_room) to switch to variantSku. Give only itemId + variantSku.",
          "type": "string",
        },
        "items": {
          "description": "Several placements in one call (instead of the single fields), at most 12.",
          "items": {
            "$ref": "#/$defs/placement",
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array",
        },
        "label": {
          "description": "Undo-history label.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "mesh": {
          "$ref": "#/$defs/placement/properties/mesh",
        },
        "position": {
          "$ref": "#/$defs/placement/properties/position",
        },
        "preview": {
          "description": "true: change nothing, return diff and warnings.",
          "type": "boolean",
        },
        "productId": {
          "$ref": "#/$defs/placement/properties/productId",
        },
        "relation": {
          "$ref": "#/$defs/placement/properties/relation",
        },
        "render": {
          "anyOf": [
            {
              "type": "boolean",
            },
            {
              "additionalProperties": true,
              "type": "object",
            },
          ],
          "description": "true or render_view arguments: also return an image (true: first changed room, else the whole flat).",
        },
        "roomId": {
          "$ref": "#/$defs/placement/properties/roomId",
        },
        "rotation": {
          "$ref": "#/$defs/placement/properties/rotation",
        },
        "variantSku": {
          "$ref": "#/$defs/placement/properties/variantSku",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "place_item",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Overview of the flat: name, revision, site, counts, rooms (id, name, type, area), materials in use, defaults, session lighting date, history position. Start here. detail "full" adds finishes per room, all materials, lights and opening counts.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "description": "brief (default, about 1.5k tokens) or full.",
          "enum": [
            "brief",
            "full",
          ],
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "get_scene_summary",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the rooms: id, name, type, area, wall/floor/ceiling material ids, counts of windows, doors and lights.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object",
    },
    "name": "list_rooms",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Describe one room: area, ceiling height, the wall faces that border it (structural flag, finish and where it comes from, wallOn = which side of the room the wall is on, left/right side, wallId), openings with compass = the direction you look through them, lights, daylight factor and hours of direct sun for a date (default: the session date, see set_sun_time).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Local date YYYY-MM-DD at the flat; default: the session lighting date.",
          "type": "string",
        },
        "roomId": {
          "description": "Room id (see list_rooms).",
          "type": "string",
        },
      },
      "required": [
        "roomId",
      ],
      "type": "object",
    },
    "name": "describe_room",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List materials, one line per entry: the library textures you can use with material_define (kind "texture", textureUrl "lib:<slug>") and the materials already defined in this flat. Filter by text and/or library category.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Library category.",
          "enum": [
            "floor-wood",
            "floor-tile",
            "wall-plaster",
            "wall-paper",
            "stone",
            "outdoor",
          ],
          "type": "string",
        },
        "query": {
          "description": "Case-insensitive text to look for in slug, name or category.",
          "maxLength": 80,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "list_materials",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the product providers (shops) the server can search: id, label, whether it is enabled, what it can do (search, real 3D model, dimension quality, pasted URLs), its circuit state (open = paused after repeated blocks; retryAt) and whether its data may only be used personally. Call it before search_products to pick a provider id.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object",
    },
    "name": "list_providers",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Search real, purchasable furniture at the enabled providers. Returns at most 12 compact results (productId, name, TTC price, assembled dims w x d x h in metres, colours, has3d = a real 3D model exists). The returned productIds are the only ones place_item accepts in this session. Filter by category, maxPrice and the maximum width/depth/height that fits the room (use describe_room for its size) so results fit. Prices are indicative shelf prices. Limited to 20 searches per minute.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Furniture category.",
          "enum": [
            "bed",
            "wardrobe",
            "bedside",
            "drawers",
            "shelf",
            "sideboard",
            "tv_unit",
            "table",
            "desk",
            "chair",
            "armchair",
            "sofa",
            "rug",
            "lamp",
            "mirror",
            "wall_cabinet",
            "kitchen",
            "appliance",
            "decor",
            "other",
          ],
          "type": "string",
        },
        "colour": {
          "description": "Keep products that come in this colour (case-insensitive text match on the colour names).",
          "maxLength": 40,
          "type": "string",
        },
        "limit": {
          "description": "Results wanted, default 8.",
          "maximum": 12,
          "minimum": 1,
          "type": "integer",
        },
        "maxDepth": {
          "description": "Deepest acceptable product, metres (item z).",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "maxHeight": {
          "description": "Tallest acceptable product, metres.",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "maxPrice": {
          "description": "Highest TTC price, in the product currency (EUR for the shops here).",
          "minimum": 0,
          "type": "number",
        },
        "maxWidth": {
          "description": "Widest acceptable product, metres (item x).",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "provider": {
          "description": "Restrict to one provider id (list_providers). Default: every enabled provider.",
          "type": "string",
        },
        "query": {
          "description": "Words to look for, e.g. "bed 160", "oak desk". May be empty with a category.",
          "maxLength": 200,
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_products",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Full facts of one product from search_products: price (TTC), link, assembled dimensions, colours, variants (variants[].sku with their own price and dims, for place_item variantSku), weightKg (wall mounts over 15 kg need a structural wall), has3d and when the data was read. Use it for the few products you intend to place. Limited to 60 per minute.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "productId": {
          "description": "productId from search_products, "<provider>:<sku>".",
          "type": "string",
        },
      },
      "required": [
        "productId",
      ],
      "type": "object",
    },
    "name": "get_product",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Find SHAPES (not products) for place_item's optional mesh argument: parametric generators with their parameter ranges ({kind:"parametric", generator, params}; the dims must match the product within 2%) and the CC0 model library ({kind:"lookalike", assetId}; scaled to the product, at most 25% distortion). Normally you do not need it: place_item picks the real model, else a lookalike, else a parametric shape by itself.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Furniture category.",
          "enum": [
            "bed",
            "wardrobe",
            "bedside",
            "drawers",
            "shelf",
            "sideboard",
            "tv_unit",
            "table",
            "desk",
            "chair",
            "armchair",
            "sofa",
            "rug",
            "lamp",
            "mirror",
            "wall_cabinet",
            "kitchen",
            "appliance",
            "decor",
            "other",
          ],
          "type": "string",
        },
        "limit": {
          "description": "Library models wanted, default 12.",
          "maximum": 30,
          "minimum": 1,
          "type": "integer",
        },
        "maxDims": {
          "additionalProperties": false,
          "description": "Keep library models whose authored size fits this box (metres). Generators are resizable, so they are always kept.",
          "properties": {
            "d": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "h": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "w": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
          },
          "type": "object",
        },
        "style": {
          "description": "A style tag to prefer/filter, e.g. "wood", "modern" (library models).",
          "maxLength": 32,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "search_assets",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Dry run of the placement solver, nothing changes: where could this product go in this room for a relation (against_wall, in_corner, centered_in, facing, next_to, under_window, at)? Returns up to 3 candidate spots (position, rotation, elevation, the relation to pass to place_item) with reasons, or the violations (outside_room, overlap, door_swing_blocked, ...) with alternatives. The product must come from search_products in this session.",
    "inputSchema": {
      "$defs": {
        "relation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "align": {
                  "default": "center",
                  "description": "Where along the wall, seen from the room: its start end, its middle, or its end.",
                  "enum": [
                    "start",
                    "center",
                    "end",
                  ],
                  "type": "string",
                },
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "against_wall",
                  "description": "Relation discriminator, always "against_wall".",
                  "type": "string",
                },
                "offset": {
                  "default": 0,
                  "description": "Metres from the aligned end of the wall to the nearest edge of the item (ignored for "center").",
                  "minimum": 0,
                  "type": "number",
                },
                "roomId": {
                  "description": "Room on the wall side to use when a wall borders two rooms (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "wallId": {
                  "description": "Wall to stand against (walls[].wallId from describe_room).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "wallId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "corner": {
                  "description": "Index of the room polygon vertex (rooms[].polygon order); 0 is the first vertex.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "in_corner",
                  "description": "Relation discriminator, always "in_corner".",
                  "type": "string",
                },
                "roomId": {
                  "description": "Room whose corner to use (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "roomId",
                "corner",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "default": "both",
                  "description": "Centre on both plan axes, or only on x / y (the other coordinate is then kept).",
                  "enum": [
                    "both",
                    "x",
                    "y",
                  ],
                  "type": "string",
                },
                "kind": {
                  "const": "centered_in",
                  "description": "Relation discriminator, always "centered_in".",
                  "type": "string",
                },
                "roomId": {
                  "description": "Room to centre in (rooms[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "roomId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "facing",
                  "description": "Relation discriminator, always "facing".",
                  "type": "string",
                },
                "targetId": {
                  "description": "Entity to face: an item id, an opening id, a wall id or a room id.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "targetId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "align": {
                  "default": "center",
                  "description": "Alignment along that side: start, middle or end.",
                  "enum": [
                    "start",
                    "center",
                    "end",
                  ],
                  "type": "string",
                },
                "gap": {
                  "default": 0.02,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "itemId": {
                  "description": "The existing item to stand next to (items[].id).",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
                "kind": {
                  "const": "next_to",
                  "description": "Relation discriminator, always "next_to".",
                  "type": "string",
                },
                "side": {
                  "description": "Side of that item, as seen from its front.",
                  "enum": [
                    "left",
                    "right",
                    "front",
                    "back",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "itemId",
                "side",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "gap": {
                  "default": 0,
                  "description": "Gap in m to what it touches (0).",
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "under_window",
                  "description": "Relation discriminator, always "under_window".",
                  "type": "string",
                },
                "openingId": {
                  "description": "Window (openings[].id) to stand under.",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "openingId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "elevation": {
                  "default": 0,
                  "description": "Height of the item bottom above the floor, in metres.",
                  "minimum": 0,
                  "type": "number",
                },
                "kind": {
                  "const": "at",
                  "description": "Relation discriminator, always "at".",
                  "type": "string",
                },
                "position": {
                  "description": "Plan position [x, y] of the item origin (footprint centre).",
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                  ],
                  "type": "array",
                },
                "rotation": {
                  "default": 0,
                  "description": "Degrees counter-clockwise seen from above.",
                  "type": "number",
                },
              },
              "required": [
                "kind",
                "position",
              ],
              "type": "object",
            },
          ],
        },
      },
      "additionalProperties": false,
      "properties": {
        "productId": {
          "description": "productId returned by search_products or get_product in this session, "<provider>:<sku>".",
          "type": "string",
        },
        "relation": {
          "$ref": "#/$defs/relation",
          "description": "The relation to try.",
        },
        "roomId": {
          "description": "Room to place in (list_rooms).",
          "type": "string",
        },
        "variantSku": {
          "description": "A variants[].sku from get_product (another colour or size).",
          "type": "string",
        },
      },
      "required": [
        "productId",
        "roomId",
        "relation",
      ],
      "type": "object",
    },
    "name": "get_placement_options",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Check the placed furniture of one room (or the whole flat) against the layout rules: inside the room, no overlaps, door swings and landings, window sills, glazing, walkways at least 0.8 m (0.9 m at the entry). Returns violations and warnings with the entities and a hint, the free floor area, the narrowest walkway, and totalEur (TTC prices of unlocked items; locked existing furniture counts 0) plus overBudget when budgetEur is given. Call it after placing and before you finish.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "budgetEur": {
          "description": "Budget in EUR (TTC prices only). With roomId it is compared with that room's items, else with the whole flat.",
          "minimum": 0,
          "type": "number",
        },
        "roomId": {
          "description": "Room to check (list_rooms). Default: every room.",
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "validate_layout",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Shopping list of the placed items, grouped by product: productId, name, link, quantity, unit price, what is left to buy (toBuy) and the amount. totalEur counts the TTC prices of unlocked items only (locked existing furniture is listed at 0; delivery, assembly and discounts are not included), byRoom has the subtotals, stale lists price snapshots older than 7 days. Prices are indicative.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "description": "Only the items of this room (list_rooms). Default: the whole flat.",
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "get_bill_of_materials",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Set the session's date, time or lighting preset (day / evening / night) used by later describe_room and render_view calls. It does not change the flat and is not undoable. Times are local at the flat (its time zone, DST aware). sync_to_user_tab also shows it in the user's open tab.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Local date YYYY-MM-DD at the flat.",
          "type": "string",
        },
        "lamps": {
          "description": "scene: lamps follow the flat (light_update changes show). allOn / allOff: force every lamp on / off. A preset sets this (day: allOff; evening and night: allOn) and it stays until you change it: pass "scene" to go back to the flat's own lamp states.",
          "enum": [
            "scene",
            "allOn",
            "allOff",
          ],
          "type": "string",
        },
        "preset": {
          "description": "day: 12:00 sun, lamps off. evening: 20:00 on 21 Dec, lamps on. night: 23:00, no sun, lamps on. Applied first; date and time then override it.",
          "enum": [
            "day",
            "evening",
            "night",
          ],
          "type": "string",
        },
        "sync_to_user_tab": {
          "description": "true: also relay this lighting to the user's open tab (shown only if they follow the assistant view).",
          "type": "boolean",
        },
        "time": {
          "description": "Local time HH:mm at the flat.",
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "set_sun_time",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Render the flat",
    },
    "description": "Render the flat to an image (PNG, or JPEG) to see a change or answer a question about the light: view "room" (overview of one room), "walk" (standing in a room at eye level, optionally facing a compass point, wall or opening), "top" (plan) or "orbit" (the whole flat from above). Choose the time of day with date/time or preset (day, evening, night) and lamps; defaults to the session lighting (set_sun_time), else noon on 21 June. compare: "before_after" adds the previous render of this session as a second image. Takes a few seconds; the first call starts a browser.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "description": "Also return the flat as it was at the previous render_view of this session, as a second image (same camera and lighting).",
          "enum": [
            "before_after",
          ],
          "type": "string",
        },
        "date": {
          "description": "Local date YYYY-MM-DD at the flat. Default: the session date (set_sun_time), else 2026-06-21.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "exposureEV": {
          "default": 0,
          "description": "Exposure compensation in EV stops, -6 to 6.",
          "maximum": 6,
          "minimum": -6,
          "type": "number",
        },
        "facing": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            {
              "maximum": 360,
              "minimum": -360,
              "type": "number",
            },
          ],
          "description": "walk only: a compass point N NE E SE S SW W NW (true north), degrees clockwise from plan-up, or the id of a wall or opening of that room to look at (e.g. "door-balcony-sejour"). Default: the room centre.",
        },
        "format": {
          "default": "png",
          "description": "png (lossless, default) or jpeg (quality 80, smaller).",
          "enum": [
            "png",
            "jpeg",
          ],
          "type": "string",
        },
        "lamps": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "kelvin": {
                "maximum": 12000,
                "minimum": 1000,
                "type": "number",
              },
              "lumens": {
                "minimum": 0,
                "type": "number",
              },
              "on": {
                "type": "boolean",
              },
            },
            "type": "object",
          },
          "default": {},
          "description": "Per-lamp overrides keyed by light id, e.g. {"l-sejour":{"on":true,"kelvin":2700}}.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "pose": {
          "description": "Advanced: an explicit camera; replaces view/roomId/facing for placement.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "azimuthDeg": {
                  "maximum": 360,
                  "minimum": -360,
                  "type": "number",
                },
                "distance": {
                  "exclusiveMinimum": 0,
                  "maximum": 200,
                  "type": "number",
                },
                "elevationDeg": {
                  "maximum": 89,
                  "minimum": 5,
                  "type": "number",
                },
                "fovDeg": {
                  "default": 50,
                  "maximum": 110,
                  "minimum": 10,
                  "type": "number",
                },
                "mode": {
                  "const": "orbit",
                  "type": "string",
                },
                "target": {
                  "items": false,
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                  ],
                  "type": "array",
                },
              },
              "required": [
                "mode",
                "target",
                "azimuthDeg",
                "elevationDeg",
                "distance",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "eyeHeight": {
                  "default": 1.6,
                  "maximum": 3,
                  "minimum": 0.3,
                  "type": "number",
                },
                "fovDeg": {
                  "default": 70,
                  "maximum": 120,
                  "minimum": 30,
                  "type": "number",
                },
                "headingDeg": {
                  "maximum": 360,
                  "minimum": -360,
                  "type": "number",
                },
                "mode": {
                  "const": "walk",
                  "type": "string",
                },
                "pitchDeg": {
                  "default": 0,
                  "maximum": 80,
                  "minimum": -80,
                  "type": "number",
                },
                "position": {
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                  ],
                  "type": "array",
                },
              },
              "required": [
                "mode",
                "position",
                "headingDeg",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "center": {
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "number",
                    },
                  ],
                  "type": "array",
                },
                "halfHeight": {
                  "exclusiveMinimum": 0,
                  "maximum": 200,
                  "type": "number",
                },
                "mode": {
                  "const": "top",
                  "type": "string",
                },
                "rotationDeg": {
                  "default": 0,
                  "maximum": 360,
                  "minimum": -360,
                  "type": "number",
                },
              },
              "required": [
                "mode",
                "center",
                "halfHeight",
              ],
              "type": "object",
            },
          ],
        },
        "preset": {
          "description": "day: 12:00 sun, lamps off. evening: 20:00 on 21 Dec, lamps on. night: 23:00 no sun, lamps on. Applied before date, time and lamps.",
          "enum": [
            "day",
            "evening",
            "night",
          ],
          "type": "string",
        },
        "roomId": {
          "description": "Required for room and walk. For top and orbit it frames just that room. See list_rooms.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "size": {
          "additionalProperties": false,
          "description": "Pixels. Default 1024x768; the long edge is clamped to 1568.",
          "properties": {
            "height": {
              "maximum": 4096,
              "minimum": 64,
              "type": "integer",
            },
            "width": {
              "maximum": 4096,
              "minimum": 64,
              "type": "integer",
            },
          },
          "required": [
            "width",
            "height",
          ],
          "type": "object",
        },
        "time": {
          "description": "Local time HH:mm at the flat.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
        },
        "view": {
          "default": "room",
          "description": "room: overview of roomId from above; walk: eye level standing in roomId; top: plan view of the flat (or roomId); orbit or flat: the whole flat (or roomId) from 45 degrees.",
          "enum": [
            "room",
            "walk",
            "top",
            "orbit",
            "flat",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "render_view",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the undo and redo stacks (who changed what, newest last) and the named checkpoints. The stack is shared with the user: undo reverts the latest entry whoever made it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "How many of the newest entries to list (default 20).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "list_history",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Undo the newest entry of the shared history, whoever made it (the user's edits included); the result names the entry it reverted. To undo only what you have seen, pass expectId (the id of the last entry of list_history's past): if the newest entry is a different one, it fails with stale_scene and changes nothing. Without expectId it reverts whatever is on top at that moment.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expectId": {
          "description": "Optional. Id of the entry you mean to undo (the last item of past in list_history). Mismatch: stale_scene, nothing undone.",
          "maxLength": 64,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "undo",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Redo the most recently undone change (the user's too). Pass expectId (redoNext[0].id of list_history) to redo only that entry: if the next one differs, it fails with stale_scene and changes nothing.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expectId": {
          "description": "Optional. Id of the entry you mean to redo (redoNext[0] in list_history). Mismatch: stale_scene, nothing redone.",
          "maxLength": 64,
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "redo",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Name the current state so you can return to it with restore_checkpoint. A name that exists is refused unless replace is true (which moves it to now). Take one before big edits.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Checkpoint name.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
        "replace": {
          "description": "true: move an existing checkpoint of that name to the current state (default false).",
          "type": "boolean",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "checkpoint",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Undo back to a named checkpoint, whoever made the changes since (the undone steps stay redoable). Fails with precondition_failed when the history was undone past the checkpoint or diverged from it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Checkpoint name (see list_history).",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "restore_checkpoint",
  },
]
`;
