[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Create a material, or fully replace an existing one with the same id (upsert, FULL REPLACE: omitted optional fields are cleared and roughness resets to 0.9, so send every field you want to keep). A material kind ("paint" or "texture") can never change; use a new id for a different kind. For a library texture use kind "texture" with textureUrl "lib:<slug>" (slugs: library[].slug from list_materials). Define a material before using it in a finish.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ifRev": {
          "description": "Optional. Apply only if the flat is still at this revision, else stale_scene and nothing changes. Pass baseRev from a preview of the same change to apply only if nothing changed since; or rev from a previous result.",
          "minimum": 0,
          "type": "integer",
        },
        "label": {
          "description": "Short description of this change, shown in the undo history (at most 200 characters).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "material": {
          "additionalProperties": false,
          "description": "The complete material. An existing id is fully replaced (omitted optional fields are cleared); kind cannot change.",
          "properties": {
            "color": {
              "description": "Base colour as #rrggbb. For textures it is the fallback and tint colour.",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string",
            },
            "id": {
              "description": "Material id (1-64 characters), unique across all entities. Reference it from finishes and defaults.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "kind": {
              "description": ""paint" is a flat colour; "texture" adds a PBR texture set (needs textureUrl). Cannot change once defined.",
              "enum": [
                "paint",
                "texture",
              ],
              "type": "string",
            },
            "name": {
              "description": "Human-readable name, at most 120 characters.",
              "maxLength": 120,
              "type": "string",
            },
            "roughness": {
              "default": 0.9,
              "description": "Surface roughness from 0 (mirror) to 1 (matte). Defaults to 0.9.",
