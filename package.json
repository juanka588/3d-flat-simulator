{
  "name": "3d-flat-simulator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @flat/web dev",
    "server": "pnpm --filter @flat/server start",
    "dev:all": "pnpm --parallel --filter @flat/server --filter @flat/web dev",
    "mcp": "pnpm --silent --filter @flat/mcp start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test",
    "test:render": "MCP_RENDER=1 vitest run --project mcp src/render/render.test.ts src/render/latency.test.ts src/render/stdioRender.test.ts",
    "mcp:demo": "node scripts/mcp-demo/llm-demo.mjs",
    "mcp:demo:cli": "node scripts/mcp-demo/claude-cli-demo.mjs",
    "mcp:setup": "node scripts/mcp-setup.mjs",
    "providers:probe": "pnpm --silent --filter @flat/server exec tsx src/providers/probe.ts",
    "materials:build": "node scripts/materials/build.mjs",
    "materials:credits": "node scripts/materials/credits.mjs",
    "assets:sheet": "tsx scripts/assets/contact-sheet.mjs",
    "models:build": "node scripts/models/build.mjs",
    "models:credits": "node scripts/models/credits.mjs",
    "models:contact-sheet": "node scripts/models/contact-sheet.mjs",
    "models:local": "node scripts/models/local.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
