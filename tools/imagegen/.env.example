# Copy to .env next to compose.yaml. Never commit .env (it may hold HF_TOKEN / IMAGEGEN_TOKEN).

# --- Profile -------------------------------------------------------------------------------------------------------
# rtx-8gb | rtx-12gb | rtx-16gb | rtx-24gb | rtx-48gb | rtx-80gb. Each sets the knobs below; any knob you set wins.
# rtx-12gb is the RTX 5070: Qwen-Image nf4 + sequential CPU offload, klein bf16 + model offload, 1024 px, 8 steps.
PROFILE=rtx-12gb

# --- Presets (copy the lines you want over the "knobs" section; same values as the profiles) --------------------------
# rtx-12gb   IMAGEGEN_PRECISION=nf4   IMAGEGEN_CPU_OFFLOAD=sequential  IMAGEGEN_MAX_SIDE=1024  IMAGEGEN_STEPS=8
# rtx-16gb   IMAGEGEN_PRECISION=nf4   IMAGEGEN_CPU_OFFLOAD=sequential  IMAGEGEN_MAX_SIDE=1280  IMAGEGEN_STEPS=8
# rtx-24gb   IMAGEGEN_PRECISION=nf4   IMAGEGEN_CPU_OFFLOAD=model       IMAGEGEN_MAX_SIDE=1536  IMAGEGEN_STEPS=8
# rtx-48gb   IMAGEGEN_PRECISION=fp8   IMAGEGEN_CPU_OFFLOAD=model       IMAGEGEN_MAX_SIDE=1536  IMAGEGEN_STEPS=8
# (rtx-8gb: nf4 + sequential, 768 px.  rtx-80gb: bf16, no offload.)

# --- Knobs (empty = the profile's value) ---------------------------------------------------------------------------------
# Qwen-Image transformer precision: bf16 | fp8 | nf4
IMAGEGEN_PRECISION=
# Qwen-Image CPU offload: false | true (lightest that is likely to fit) | model | sequential
IMAGEGEN_CPU_OFFLOAD=
# Longest image edge accepted (requests above it are rejected; the default size shrinks to fit)
IMAGEGEN_MAX_SIDE=
# Default steps for qwen-cn when a request gives none (8 with the Lightning LoRA, 30 without)
IMAGEGEN_STEPS=
# true | false: the 8-step Qwen-Image-Lightning LoRA (default true)
IMAGEGEN_LIGHTNING=

# --- Access -------------------------------------------------------------------------------------------------------------
# Browser origins allowed to call the API (none by default; the MCP server sends no Origin header).
IMAGEGEN_ALLOWED_ORIGINS=
# LAN access is OFF by default (published on 127.0.0.1 only). To enable, see README "LAN access": set all three.
#IMAGEGEN_PUBLISH=0.0.0.0
#IMAGEGEN_ALLOWED_HOSTS=192.168.1.20
#IMAGEGEN_TOKEN=a-long-random-string
IMAGEGEN_PUBLISH=
IMAGEGEN_ALLOWED_HOSTS=
IMAGEGEN_TOKEN=
# Host port (the container always listens on 8790)
IMAGEGEN_HOST_PORT=

# --- Downloads ----------------------------------------------------------------------------------------------------------
# Optional Hugging Face token (never logged). Not needed for the models used here.
HF_TOKEN=
# false: models must already be in the /models volume (see README "First run"). true: the first job downloads them.
IMAGEGEN_ALLOW_DOWNLOAD=false
